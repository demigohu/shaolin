# Use ONE of these setups:

# A) OpenRouter
# OPENROUTER_API_KEY=sk-or-...
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=openrouter/healer-alpha

# B) Custom OpenAI-compatible endpoint (LLM_MODEL in .env overrides openrouter/* in user-config.json)
LLM_API_KEY=your-key
LLM_BASE_URL=https://your-rpc.example.com/v1
LLM_MODEL=your-model-id

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ALLOWED_USER_IDS=

MARKETAUX_API_TOKEN=

DRY_RUN=true
LOG_LEVEL=info
