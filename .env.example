# LLM — any OpenAI-compatible endpoint (OpenRouter by default).
# LLM_MODEL in .env overrides openrouter/* models in user-config.json when LLM_BASE_URL is not OpenRouter.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Comma-separated user/chat IDs allowed to command the bot. Empty = only TELEGRAM_CHAT_ID.
TELEGRAM_ALLOWED_USER_IDS=

# Marketaux gold headlines (optional, free plan is enough: ~50 requests/day at the default 30 min cache)
MARKETAUX_API_TOKEN=

LOG_LEVEL=info

# Optional: Webshare proxy for the MCP's Yahoo requests (avoids HTTP 429 on VPS)
# PROXY_ENABLED=true
# PROXY_HOST=p.webshare.io
# PROXY_PORT=80
# PROXY_USERNAME_PREFIX=your_prefix
# PROXY_PASSWORD=your_password
# Session numbers used as <prefix>-<n>; set MAX to how many proxies your Webshare plan has.
# PROXY_SESSION_MIN=1
# PROXY_SESSION_MAX=10
